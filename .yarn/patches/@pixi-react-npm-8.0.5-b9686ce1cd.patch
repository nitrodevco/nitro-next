diff --git a/lib/helpers/removeChild.js b/lib/helpers/removeChild.js
index 47c25cb7d7028d8e11d0556f00b7a54f3f10a436..c29e4bbcf67ea100b30d769497545c57aab118db 100644
--- a/lib/helpers/removeChild.js
+++ b/lib/helpers/removeChild.js
@@ -5,12 +5,28 @@ var detach = require('./detach.js');
 var log = require('./log.js');
 
 "use strict";
+/**
+ * React calls `removeChild` only for the topmost host instance of a removed subtree, and a plain
+ * `destroy()` leaves its descendants undestroyed - so every nested container's @pixi/layout Yoga
+ * node (WASM memory, never garbage collected) leaked with each closed window (nitro patch). This
+ * destroys the descendants React created; a child added imperatively (`__pixireact` unset) is
+ * detached instead, left to whoever added it.
+ */
+function destroyInstance(instance) {
+  const children = instance.children ? [...instance.children] : [];
+  for (const child of children) {
+    if (child.destroyed) continue;
+    if (child.__pixireact) destroyInstance(child);
+    else instance.removeChild(child);
+  }
+  instance.destroy();
+}
 function removeChild(_parentInstance, childInstance) {
   log.log("info", "lifecycle::removeChild");
   if (childInstance instanceof pixi_js.Filter) {
     detach.detach(childInstance);
   }
-  childInstance.destroy();
+  destroyInstance(childInstance);
 }
 
 exports.removeChild = removeChild;
