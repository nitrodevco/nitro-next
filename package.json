{
    "name": "nitro-next",
    "packageManager": "yarn@4.19.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npx update-browserslist-db@latest && yarn workspaces foreach --all -pt run build",
        "typecheck": "yarn workspaces foreach --all -pt run typecheck",
        "lint": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js .",
        "lint:fix": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js . --fix",
        "clean": "yarn workspaces foreach --all -pt run clean",
        "dev": "yarn workspace @nitrodevco/nitro-react dev",
        "build-client": "yarn workspace @nitrodevco/nitro-react build",
        "start-studio": "yarn workspace @nitrodevco/nitro-studio start"
    },
    "dependencies": {
        "pixi.js": "^8.18.1"
    },
    "resolutions": {
        "pixi.js@npm:^8.18.1": "patch:pixi.js@npm%3A8.23.0#~/.yarn/patches/pixi.js-npm-8.23.0-fe5801e853.patch",
        "@pixi/react@npm:^8.0.0": "patch:@pixi/react@npm%3A8.0.5#~/.yarn/patches/@pixi-react-npm-8.0.5-b9686ce1cd.patch",
        "@pixi/react@npm:^8.0.5": "patch:@pixi/react@npm%3A8.0.5#~/.yarn/patches/@pixi-react-npm-8.0.5-b9686ce1cd.patch"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^6.0.1",
        "@types/node": "^26.6.6",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.15.0",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.14.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.73.0"
    }
}
