{
    "name": "@nitrodevco/client-module-sdk",
    "version": "1.0.0",
    "private": true,
    "description": "Types, helpers and the bundler preset for Nitro client modules",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./theme": "./src/theme.ts",
        "./types": "./src/types.d.ts",
        "./build": {
            "types": "./src/build.d.ts",
            "default": "./src/build.js"
        }
    },
    "files": [
        "src"
    ],
    "scripts": {
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "tsx --test test/*.test.ts"
    },
    "peerDependencies": {
        "@types/react": "^19.0.0",
        "esbuild": ">=0.25.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "esbuild": "^0.28.2",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    },
    "peerDependenciesMeta": {
        "esbuild": {
            "optional": true
        }
    }
}
