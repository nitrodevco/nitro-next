# Copy to .env (or set these in the process environment, which wins).

IMAGER_HOST=127.0.0.1
IMAGER_PORT=3030
# Encoded images kept in memory, in MB; the least recently used go past it.
IMAGER_CACHE_MB=64
# Avatar asset libraries kept loaded before the ones no render is using are unloaded. Each figure
# loads its clothing's; this is what bounds the imager's memory (about 800 MB resident at 300).
IMAGER_MAX_LIBRARIES=300

# The avatar data and libraries: the same addresses as the client's asset.bundles.templates,
# asset.bundles.avatar, asset.bundles.effects, figuremap.url, figuredata.url and effectmap.url.
#
# Each may be a url or a path on this server, mixed freely. A bundle path is a folder holding
# <library>.nitro (IMAGER_FIGURE_BUNDLE_URL=/srv/nitro/bundled/figures), or a path with
# %libname% in it; a map or figure data path is the file; IMAGER_BADGE_PART_URL may be the folder
# of badgepart_*.png. A relative path is from the imager's working directory, and a path that is
# not there stops the imager at start-up.
IMAGER_TEMPLATES_URL=https://images.nitrodev.co/bundled/templates/%libname%.nitro
IMAGER_FIGURE_BUNDLE_URL=https://images.nitrodev.co/bundled/figures/%libname%.nitro
IMAGER_EFFECT_BUNDLE_URL=https://images.nitrodev.co/bundled/effects/%libname%.nitro
IMAGER_FIGUREMAP_URL=https://images.nitrodev.co/gamedata/FigureMap.json
IMAGER_FIGUREDATA_URL=https://nitrodev.co/gamedata/figuredata_json/0
IMAGER_EFFECTMAP_URL=https://images.nitrodev.co/gamedata/EffectMap.json

# Pets (/pet): the client's asset.bundles.pets. Unset, the imager draws no pets. IMAGER_PET_TYPES is
# the client's renderer.petTypes, comma separated - a pet's type is its place in the list; unset,
# the list the client's own config ships with.
IMAGER_PET_BUNDLE_URL=https://images.nitrodev.co/bundled/pet/%libname%.nitro
# IMAGER_PET_TYPES=dog,cat,croco,terrier,bear,pig,lion,rhino,spider,turtle,chicken,frog,dragon,monster,monkey,horse

# Furniture (/furni): the client's asset.bundles.furni and furnituredata.url (Turbo's
# furnidata_json gamedata file, or a file). Without both, the imager draws no furniture. Furnidata
# from a url is read again every IMAGER_FURNIDATA_REFRESH_SECONDS (0: never), so new items draw.
IMAGER_FURNITURE_BUNDLE_URL=https://images.nitrodev.co/bundled/furniture/%libname%.nitro
IMAGER_FURNIDATA_URL=https://nitrodev.co/gamedata/furnidata_json/0
IMAGER_FURNIDATA_REFRESH_SECONDS=600

# Group badges: the client's image.library.badgepart.url, and the hotel's part and colour table -
# Turbo's badgeparts_json gamedata file. Unset, the copy in data/badge-parts.json is used.
IMAGER_BADGE_PART_URL=https://images.habbo.com/c_images/Badgeparts/
# IMAGER_BADGE_PARTS=http://127.0.0.1:8094/gamedata/badgeparts_json/0
IMAGER_BADGE_PARTS_REFRESH_SECONDS=300
