{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "jsx": "react-jsx",
        "types": [
            "vite/client"
        ],
        "paths": {
            "#base/components": [
                "./src/components/index.ts"
            ],
            "#base/handlers": [
                "./src/handlers/index.ts"
            ],
            "#base/hooks": [
                "./src/hooks/index.ts"
            ],
            "#base/theme": [
                "./src/theme/index.ts"
            ],
            "#base/utils": [
                "./src/utils/index.ts"
            ],
            "#base/*": [
                "./src/*"
            ],
            "#api/*": [
                "../nitro-api/src/*"
            ],
            "@nitrodevco/client-module-sdk/types": [
                "../client-module-sdk/src/types.d.ts"
            ],
        },
    },
    "references": [
        {
            "path": "../nitro-api"
        },
        {
            "path": "../nitro-packets"
        },
        {
            "path": "../nitro-renderer"
        },
        {
            "path": "../nitro-theme"
        }
    ],
    "include": [
        "src/**/*",
        "themes/**/*"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "postcss.config.js",
        "tailwind.config.js",
        "vite.config.ts"
    ]
}