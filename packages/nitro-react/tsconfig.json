{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "types": [
            "vite/client"
        ],
        "paths": {
            "#base/components": [
                "./src/components/index.ts"
            ],
            "#base/context": [
                "./src/context/index.ts"
            ],
            "#base/handlers": [
                "./src/handlers/index.ts"
            ],
            "#base/hooks": [
                "./src/hooks/index.ts"
            ],
            "#base/theme-core": [
                "./src/theme-core/index.ts"
            ],
            "#base/theme-pixi": [
                "./src/theme-pixi/index.ts"
            ],
            "#base/utils": [
                "./src/utils/index.ts"
            ],
            "#base/*": [
                "./src/*"
            ],
        },
    },
    "references": [
        {
            "path": "../nitro-api"
        },
        {
            "path": "../nitro-packets"
        },
        {
            "path": "../nitro-renderer"
        }
    ],
    "include": [
        "src/**/*",
        "themes/**/*"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "eslint.config.js",
        "postcss.config.js",
        "prettier.config.js",
        "tailwind.config.js",
        "vite.config.ts"
    ]
}