{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "noEmit": true,
        "jsx": "react-jsx",
        "types": [
            "vite/client",
            "node"
        ],
        "paths": {
            "#api/*": [
                "../nitro-api/src/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "test/**/*"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}
