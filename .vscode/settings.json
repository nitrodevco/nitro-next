{
    "js/ts.tsdk.path": "./node_modules/typescript/lib",
    "files.eol": "\n",
    "editor.formatOnSave": true,
    "editor.detectIndentation": false,
    "editor.wordWrap": "on",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": true,
    },
    "editor.quickSuggestions": {
        "strings": true
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    // ESLint's fixAll (via codeActionsOnSave below) fully owns formatting for these languages
    // now (see @stylistic rules in eslint.config.js) - a second format-on-save pass here would
    // race against it (e.g. falling back to Prettier, which strips array-bracket spacing back
    // out right after ESLint adds it), so formatting is disabled and fixAll is the only pass.
    "[javascript,javascriptreact,typescript,typescriptreact]": {
        "editor.formatOnSave": false,
        "js/ts.preferences.importModuleSpecifier": "shortest"
    },
    "[json]": {
        "editor.tabSize": 4
    },
    "eslint.format.enable": true,
    "prettier.prettierPath": "./node_modules/prettier/index.cjs",
    "prettier.configPath": "prettier.config.js",
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "eslint.workingDirectories": [
        {
            "mode": "auto"
        }
    ],
    "tailwindAutoOptimizer.autoFixOnSave": true,
    "tailwindCSS.experimental.configFile": "./packages/nitro-react/src/index.css",
    "tailwindCSS.experimental.classRegex": [
        [
            "classes\\s*=\\s*([^;]*);",
            "'([^']*)'"
        ],
        [
            "classes\\s*=\\s*([^;]*);",
            "\"([^\"]*)\""
        ],
        [
            "classes\\s*=\\s*([^;]*);",
            "\\`([^\\`]*)\\`"
        ],
        [
            "cn\\(([^;]*)\\);?",
            "[\"'`]([^\"'`]*)[\"'`]"
        ],
        [
            "cva\\(([^;]*)\\);",
            "[\"'`]([^\"'`]*)[\"'`]"
        ],
        [
            "\\w*[Cc]lassName\\s*:\\s*([^,}]*)",
            "[\"'`]([^\"'`]*)[\"'`]"
        ],
        [
            "['\"]\\d+['\"]\\s*:\\s*([^,}\\n]+)",
            "[\"'`]([^\"'`]*)[\"'`]"
        ]
    ],
    "emmet.showExpandedAbbreviation": "inMarkupAndStylesheetFilesOnly",
    "emmet.triggerExpansionOnTab": true,
}